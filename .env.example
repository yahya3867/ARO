# npm run operator-key sets this locally. Supply a secret value on a server.
ARO_OPERATOR_KEY=
ARO_DATABASE_PATH=data/aro.db
ARO_STEP_MS=1200

# Optional model-assisted investigation
# Optional OpenRouter key with a non-renewing spending limit of $5 or less.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_MODEL=
# AGENT_MODE=deterministic

# Optional canonical browser origin behind a reverse proxy
# ARO_PUBLIC_ORIGIN=https://aro.example.org

# Optional Vercel-hosted public demo. Provision Turso's Starter plan through
# Vercel Marketplace; both values stay server-side. Local SQLite is used when unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# PUBLIC_DEMO=1
